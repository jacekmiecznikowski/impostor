    { "name": "Naokoło", "short_name": "Naokoło", "description": "Uruchom Naokoło", "url": "./?game=naokolo", "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Co mam na myśli?", "short_name": "Co mam na myśli?", "description": "Uruchom Co mam na myśli?", "url": "./?game=co-mam-na-mysli", "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Trzy w Pięć", "short_name": "Trzy w Pięć", "description": "Uruchom Trzy w Pięć", "url": "./?game=trzy-w-piec", "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
