    { "name": "Dzika Karta", "short_name": "Dzika Karta", "description": "Uruchom Dziką Kartę", "url": "./?game=dzika-karta", "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
